#!/usr/bin/env bash
# =============================================================================
# nexussim — single entrypoint for the whole NexusSim pipeline (all-in-one image)
#
#   nexussim convert  [--splits wod-perception_val]     # CPU  : wod -> py123d arrow
#   nexussim train    --clip <CLIP>                      # GPU  : NuRec 3DGS reconstruction
#   nexussim export   --clip <CLIP>                      # GPU  : -> usd-out (servable USDZ)
#   nexussim serve    [--artifact-glob '<glob>']         # GPU  : serve-grpc render server (foreground)
#   nexussim rollout  --clip <CLIP> [--hide 0|1]         # GPU  : DrivoR closed-loop eval (needs a serve)
#   nexussim all      --clip <CLIP> [--hide 0|1]         # GPU  : serve (bg) + rollout (fg) on ONE gpu
#
# All paths derive from $DATA_ROOT (default /data); point the *_ROOT / CHECKPOINT /
# NUREC_* env vars at your own storage. CHECKPOINT has no default (required for rollout/all).
# =============================================================================
set -euo pipefail

STAGE="${1:-help}"; shift || true

# ---- args -------------------------------------------------------------------
CLIP=""; HIDE=""; SPLITS="wod-perception_val"; ARTIFACT_GLOB_OVERRIDE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --clip)          CLIP="$2"; shift 2;;
    --hide)          HIDE="$2"; shift 2;;
    --splits)        SPLITS="$2"; shift 2;;
    --artifact-glob) ARTIFACT_GLOB_OVERRIDE="$2"; shift 2;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done

# ---- config (override via env) ----------------------------------------------
# Neutral defaults under a single $DATA_ROOT; point these at your own data layout.
DATA_ROOT="${DATA_ROOT:-/data}"
WOD_RAW="${WOD_RAW:-$DATA_ROOT/wod_raw}"                 # Waymo raw tfrecords (convert input)
PY123D_ROOT="${PY123D_ROOT:-$DATA_ROOT/py123d_arrow}"   # converted py123d arrow
R2S_ROOT="${R2S_ROOT:-$DATA_ROOT/reconstructions}"      # NuRec train/export outputs (usd-out lives here)
EVAL_OUT="${EVAL_OUT:-$DATA_ROOT/eval_out}"             # rollout artifacts (gifs, metrics)
CHECKPOINT="${CHECKPOINT:-}"                            # REQUIRED for rollout/all: path to the DrivoR .pth
ARTIFACT_GLOB="${ARTIFACT_GLOB_OVERRIDE:-${ARTIFACT_GLOB:-$R2S_ROOT/*/output_static/*/usd-out/*.usdz}}"

SIM=/opt/venv-sim/bin/python
CONV_BIN=/opt/venv-conv/bin
export ACCEPT_EULA=Y OMNI_KIT_ACCEPT_EULA=YES HYDRA_FULL_ERROR="${HYDRA_FULL_ERROR:-1}"

need_clip() { [ -n "$CLIP" ] || { echo "ERROR: --clip <CLIP> is required for '$STAGE'" >&2; exit 2; }; }
need_checkpoint() { [ -n "$CHECKPOINT" ] || { echo "ERROR: set CHECKPOINT=/path/to/drivor.pth for '$STAGE' (no default)" >&2; exit 2; }; }

# ---- resolve the NexusSim source at runtime ---------------------------------
# Default: the code baked into the image at build (/opt/nexussim). A developer can
# override NEXUSSIM_SRC with a mounted checkout to run fresh code without a rebuild,
# or set NEXUSSIM_REPO to clone one.
ensure_nexussim() {
  NEXUSSIM_SRC="${NEXUSSIM_SRC:-/opt/nexussim}"
  if [ ! -e "$NEXUSSIM_SRC/pyproject.toml" ] && [ -n "${NEXUSSIM_REPO:-}" ]; then
    git clone --quiet --depth 1 --branch "${NEXUSSIM_REF:-main}" "$NEXUSSIM_REPO" "$NEXUSSIM_SRC"
  fi
  [ -e "$NEXUSSIM_SRC/pyproject.toml" ] || { echo "ERROR: no NexusSim at $NEXUSSIM_SRC" >&2; exit 3; }
  # editable-reinstall so a mounted/overridden checkout runs its CURRENT code
  # (no-op cost when it's the baked /opt/nexussim)
  /opt/venv-sim/bin/pip install -q --no-deps -e "$NEXUSSIM_SRC" >/dev/null 2>&1 || true
  echo "$NEXUSSIM_SRC"
}

# ---- wait for a serve-grpc endpoint to accept connections -------------------
wait_for_serve() {  # $1=host $2=port
  echo "waiting for serve-grpc on $1:$2 ..."
  for i in $(seq 1 120); do
    (exec 3<>/dev/tcp/$1/$2) 2>/dev/null && { echo "serve-grpc up (after ${i}0s)"; return 0; }
    sleep 10
  done
  echo "ERROR: serve-grpc never came up" >&2; return 1
}

case "$STAGE" in
  # ------------------------------------------------------------------ convert -
  convert)
    export PY123D_DATA_ROOT="$PY123D_ROOT"
    "$CONV_BIN/python" -c "import cv2, tensorflow; print('conv deps OK')"
    "$CONV_BIN/py123d-conversion" dataset=wod-perception \
      dataset.parser.wod_perception_data_root="$WOD_RAW" \
      dataset.parser.splits="[$SPLITS]"
    echo "=== map.arrow present? ==="; find "$PY123D_ROOT" -name map.arrow | head
    echo "=== CONVERT WOD DONE ===" ;;

  # -------------------------------------------------------------------- train -
  train)
    need_clip; SRC=$(ensure_nexussim)
    CFGDIR=/app/internal/scripts/pycena/runtime/pycena_nrm_full.runfiles/_main/configs/apps/AV/Waymo
    # overlay recipe now ships IN the repo (open-source), not a private PVC copy
    cp "$SRC/nexussim/gs3d_converter/configs/3dgut_dynamic_static.yaml" "$CFGDIR/"
    C="$CLIP"
    /app/run --config-name=configs/apps/AV/Waymo/3dgut_dynamic_static.yaml \
      mode=train logger=dummy \
      dataset.path="$R2S_ROOT/$C/clips/$C/pai_$C.json" \
      out_dir="$R2S_ROOT/$C/output_static" \
      logger.run_id="'$C'" \
      dataset.aux_data=True \
      dataset.camera_ids=[camera_pcam_f0,camera_pcam_l0,camera_pcam_l1,camera_pcam_r0,camera_pcam_r1] \
      dataset.lidar_ids=[lidar_top_360fov] \
      dataset.n_train_sample_lidar_rays=0 \
      dataset.cuboid_tracks_params.track_label_sources=[GT_ANNOTATION] \
      dataset.samplers.batch_sampler.camera_pixel_sampler.subsample=2 \
      dataset.n_val_image_subsample=2 \
      dataset.n_train_sequential_image_subsample=2 \
      model.layers.dynamic_rigids.tracks.label_classes=[WODPerceptionBoxDetectionLabel.TYPE_VEHICLE] \
      model.layers.dynamic_deformables.tracks.label_classes=[WODPerceptionBoxDetectionLabel.TYPE_PEDESTRIAN] \
      model.layers.dynamic_rigids.initialization.name=camera-dynamic-tracks \
      +model.layers.dynamic_rigids.initialization.camera_ids=null \
      +model.layers.dynamic_rigids.initialization.step_frame=1 \
      +model.layers.dynamic_rigids.initialization.fill_with_random_points=true \
      model.layers.dynamic_deformables.initialization.name=camera-dynamic-tracks \
      +model.layers.dynamic_deformables.initialization.camera_ids=null \
      +model.layers.dynamic_deformables.initialization.step_frame=1 \
      +model.layers.dynamic_deformables.initialization.fill_with_random_points=true \
      ++model.layers.static_rigids.tracks.is_dynamic=false \
      ++model.layers.static_rigids.tracks.label_classes=[WODPerceptionBoxDetectionLabel.TYPE_VEHICLE,WODPerceptionBoxDetectionLabel.TYPE_SIGN] \
      ++model.layers.static_rigids.initialization.symmetric_axis=Y \
      ++model.layers.static_rigids.initialization.camera_ids=null \
      ++model.layers.static_rigids.initialization.step_frame=1 \
      ++model.layers.static_rigids.initialization.fill_with_random_points=true
    echo "=== TRAIN STATIC DONE ===" ;;

  # ------------------------------------------------------------------- export -
  export)
    need_clip; C="$CLIP"; RD="$R2S_ROOT/$C/output_static/$C"
    /app/run export-gaussian-plys      --config-name "$RD/config/parsed.yaml" --checkpoint-name last.ckpt --output-dir "$RD/plys" --format _3DGS
    /app/run export-sequence-tracks    --config-name "$RD/config/parsed.yaml" --checkpoint-path "$RD/checkpoints/last.ckpt" --output-dir "$RD" --world-frame --format json
    /app/run export-gaussian-usd-asset --config-name "$RD/config/parsed.yaml" --output-dir "$RD/usd-asset" --usd-schema lightfield --export-summary
    /app/run export-usdz-artifact      --config-name "$RD/config/parsed.yaml" --checkpoint-name last.ckpt --output-dir "$RD/usd-out"
    echo "=== usd-out (serve-grpc bundle) ==="; ls -la "$RD/usd-out"
    echo "=== EXPORT_STATIC_DONE ===" ;;

  # -------------------------------------------------------------------- serve -
  serve)
    exec /app/run serve-grpc --host 0.0.0.0 --enable-editing-actors --renderer default \
      --artifact-glob "$ARTIFACT_GLOB" ;;

  # ------------------------------------------------------------------ rollout -
  rollout)
    need_clip; need_checkpoint; SRC=$(ensure_nexussim); C="$CLIP"
    DR="${PY123D_ROOT}_$C"; rm -rf "$DR"; mkdir -p "$DR/logs/wod-perception_val"
    ln -s "$PY123D_ROOT/logs/wod-perception_val/$C" "$DR/logs/wod-perception_val/$C"
    mkdir -p "$EVAL_OUT/$C"; cd "$SRC"
    LD_PRELOAD="${LD_PRELOAD:-/usr/lib/x86_64-linux-gnu/libstdc++.so.6}" \
    CUDA_VISIBLE_DEVICES="${ROLLOUT_GPU:-0}" \
    NUREC_GRPC_HOST="${NUREC_GRPC_HOST:-localhost}" NUREC_GRPC_HIDE_ACTORS="${HIDE:-}" \
    PYTHONPATH="${NRE_STUBS:-$DATA_ROOT/nre_stubs}:${PYTHONPATH:-}" \
      "$SIM" scripts/tools/eval_py123d.py \
        --scenario-source py123d --py123d-data-root "$DR" --py123d-scene-index 0 \
        --render-backend nurec_grpc --model-type drivor --checkpoint "$CHECKPOINT" \
        --traffic-mode log_replay --controller pure_pursuit \
        --eval-frames "${EVAL_FRAMES:-40}" --ego-replay-frames 8 --replan-rate 5 --camera-resolution-scale 1.0 \
        --output-dir "$EVAL_OUT/$C/out"
    echo "=== ROLLOUT DONE ==="; find "$EVAL_OUT/$C/out" -name "*.gif" | head ;;

  # -------------------------------------------------- all (serve + rollout) ---
  all)
    need_clip; need_checkpoint
    # serve in background (GPU $SERVE_GPU, default 0 == same card as rollout)
    CUDA_VISIBLE_DEVICES="${SERVE_GPU:-0}" /app/run serve-grpc --host 0.0.0.0 \
      --enable-editing-actors --renderer default --artifact-glob "$ARTIFACT_GLOB" \
      > /tmp/serve.log 2>&1 &
    SERVE_PID=$!
    trap 'echo "=== serve-grpc log tail ==="; tail -40 /tmp/serve.log 2>/dev/null || true' EXIT
    wait_for_serve localhost 8080 || { tail -40 /tmp/serve.log; exit 1; }
    # rollout in foreground on GPU $ROLLOUT_GPU (default 0 == share one 3090)
    "$0" rollout --clip "$CLIP" ${HIDE:+--hide "$HIDE"}
    kill "$SERVE_PID" 2>/dev/null || true ;;

  # --------------------------------------------------------------------- help -
  help|*)
    sed -n '2,20p' "$0"; exit 0 ;;
esac
